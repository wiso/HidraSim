# Sampling-fraction vs energy (sampling/ on branch study/sampling-fraction).
# Preferred: condor/submit_run.sh <tag> <joblist> (registers the run in runs/RUNS.md).
# Direct use, from the condor/ directory on the submit host (proof-11):
#   condor_submit sampling.sub tag=<run tag> joblist=<file> [build=<builddir>] [particle=e+] [physlist=FTFP_BERT]
# joblist lines: energy[GeV] iE job nev   (seed1 = 1000*iE + job + 1)
if !defined hidra
  hidra = $ENV(HOME)/HidraSim
endif
if !defined runsdir
  runsdir = /storage_tmp/atlas/turra/hidra/sim
endif
if !defined build
  build = $(hidra)/build
endif
if !defined tag
  tag = sampling_v1
endif
if !defined joblist
  joblist = joblists/sampling_v1.txt
endif
if !defined macroargs
  macroargs =
endif
if !defined prio
  prio = 0
endif
if !defined particle
  particle = e+
endif
if !defined physlist
  physlist = FTFP_BERT
endif
rundir     = $(runsdir)/$(tag)
executable = $(hidra)/condor/sampling_job.sh
arguments  = "$(rundir) $(energy) $(ie) $(job) $(nev) $(build) $(particle) $(physlist) $(macroargs)"
initialdir = $(rundir)/logs
output     = sf_E$(energy)_$(job).out
error      = sf_E$(energy)_$(job).err
log        = sampling.$(ClusterId).log
should_transfer_files = NO
priority   = $(prio)
request_cpus   = 1
request_memory = 2GB
queue energy, ie, job, nev from $(joblist)
