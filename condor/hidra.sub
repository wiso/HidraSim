# Generic HidraSim production. Override on command line, e.g.:
#   (from proof-11, no env workarounds needed) condor_submit hidra.sub name=e20_1k njobs=50 nev=20
# Then merge: hadd out/<name>/<name>.root out/<name>/job*/DREMTubesout_Run0.root
if !defined name
  name     = test
endif
if !defined njobs
  njobs    = 1
endif
if !defined nev
  nev      = 20
endif
if !defined particle
  particle = e-
endif
if !defined energy
  energy   = 20 GeV
endif
if !defined physlist
  physlist = FTFP_BERT
endif
executable = run_job.sh
outdir     = $ENV(HOME)/HidraSim/condor/out/$(name)/job$(Process)
arguments  = "$(outdir) $(nev) $(Process)1 $(Process)7 $(particle) '$(energy)' $(physlist)"
initialdir = $ENV(HOME)/HidraSim/condor/logs
output     = $(name).$(ClusterId).$(Process).out
error      = $(name).$(ClusterId).$(Process).err
log        = $(name).$(ClusterId).log
should_transfer_files = NO
request_cpus   = 1
request_memory = 2GB
queue $(njobs)
